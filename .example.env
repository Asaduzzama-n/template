NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/your-database-name
IP_ADDRESS=127.0.0.1
PORT=5000

# ─── Security ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
# Comma-separated list of allowed origins (no spaces around commas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Redis ────────────────────────────────────────────────────────────────────
# Required for: Socket.IO horizontal scaling, BullMQ email queue, rate limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=your-email@example.com
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_PORT=587
EMAIL_HOST=smtp.example.com

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use strong random secrets in production: openssl rand -hex 64
JWT_SECRET=change-me-use-a-long-random-string-in-production
JWT_EXPIRE_IN=10d
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=180d
TEMP_JWT_SECRET=change-me-temp-secret
TEMP_JWT_EXPIRE_IN=15m

# ─── OTP Settings ────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_REQUEST_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
MAX_OTP_REQUEST_ALLOWED=5

# ─── Auth Lockout ─────────────────────────────────────────────────────────────
# LOCKOUT_STRATEGY: EXTEND (push lockout forward) | STRICT_EARLIEST (keep earliest lockout)
LOCKOUT_STRATEGY=EXTEND
MAX_WRONG_ATTEMPTS=5
RESTRICTION_MINUTES=30

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# ─── Platform ────────────────────────────────────────────────────────────────
PLATFORM_NAME=Express-Craft

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
# Base64 encode your service account JSON:
#   base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── Twilio (SMS) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-secret

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_ACCOUNT_ID=acct_your-stripe-account-id
WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key